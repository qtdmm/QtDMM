  "notes": [
    "match: exact manufacturer string as used in QtDMM's device table (addConfig).",
    "default: used for manufacturers without own entry.",
    "device_classes: optional per-class override of colors (e.g. bench_dmm, handheld_dmm).",
    "types: the kinds of instrument the manufacturer's models are (DeviceType ids); a symbol is generated for each (cmake/device_symbols.cmake), test_devicesymbol keeps the list in step with the device table.",
    "keys: the folder of the generated symbols, :/devices/<key>/<type>.svg - lower case, [a-z0-9_] only."
  ]
}
