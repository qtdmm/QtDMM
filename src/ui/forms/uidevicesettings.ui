   <item>
    <widget class="QGroupBox" name="ui_sigrokGroup">
     <property name="title">
      <string>sigrok-cli</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_sigrok">
      <item row="0" column="0">
       <widget class="QLabel" name="ui_sigrokDriverLabel">
        <property name="text">
         <string>&amp;Driver:</string>
