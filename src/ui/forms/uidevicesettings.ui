        <item><property name="text"><string notr="true">AC</string></property></item>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="ui_virtualMinLabel">
        <property name="text">
         <string>M&amp;in:</string>
        </property>
        <property name="buddy">
         <cstring>ui_virtualMin</cstring>
        </property>
       </widget>
