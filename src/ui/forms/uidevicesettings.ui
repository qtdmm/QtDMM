      </item>
      <item row="3" column="3">
       <widget class="QLineEdit" name="ui_virtualNoise">
        <property name="whatsThis">
         <string>Peak-to-peak amplitude of random noise added to the signal, in the unit above. 0 for a clean signal.</string>
        </property>
        <property name="text">
         <string notr="true">0</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
