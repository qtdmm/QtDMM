      </item>
      <item row="2" column="1" colspan="2">
       <widget class="QLineEdit" name="ui_sigrokOptions">
        <property name="whatsThis">
         <string>Further driver options, colon separated, e.g. serialcomm=9600/8n1 for a serial connection.</string>
        </property>
        <property name="placeholderText">
         <string notr="true">serialcomm=9600/8n1</string>
