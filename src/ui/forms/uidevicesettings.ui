        <property name="text">
         <string>&amp;Test</string>
        </property>
        <property name="whatsThis">
         <string>Runs sigrok-cli --scan with these settings and shows whether the meter answers.</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="ui_sigrokOptionsLabel">
