   <item>
    <widget class="QGroupBox" name="ui_virtualGroup">
     <property name="title">
      <string>Signal</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_virtual">
      <item row="0" column="0">
       <widget class="QLabel" name="ui_virtualSignalLabel">
