    <width>500</width>
    <height>450</height>
   </size>
  </property>
  <property name="windowIcon">
   <iconset resource="../resources.qrc">
    <normaloff>:/Symbols/icon.xpm</normaloff>:/Symbols/icon.xpm</iconset>
  </property>
  <widget class="QWidget" name="centralwidget"/>
  <widget class="QStatusBar" name="statusbar"/>
