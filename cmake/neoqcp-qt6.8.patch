diff --git a/src/global.h b/src/global.h
index 367bde79..bcf7f2fa 100644
--- a/src/global.h
+++ b/src/global.h
@@ -437,4 +437,12 @@ Q_DECLARE_OPERATORS_FOR_FLAGS(QCP::PlottingHints)
 Q_DECLARE_OPERATORS_FOR_FLAGS(QCP::MarginSides)
 Q_DECLARE_OPERATORS_FOR_FLAGS(QCP::Interactions)
 
+
+// local patch for Qt 6.8 (QImage::flipped is Qt 6.9)
+#include <QImage>
+inline QImage qcpFlipped68(const QImage &image, Qt::Orientations o)
+{
+    return image.mirrored(o.testFlag(Qt::Horizontal), o.testFlag(Qt::Vertical));
+}
+
 #endif // QCP_GLOBAL_H
